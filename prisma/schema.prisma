generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Job {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  category     String
  type         String
  level        String
  duration     String
  experience   String        @default("0-1")
  description  String
  requirements String
  deadline     DateTime?
  status       String        @default("open") // open, closed
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id               String   @id @default(cuid())
  jobId            String?
  job              Job?     @relation(fields: [jobId], references: [id])
  fullName         String
  email            String
  phone            String
  resumeUrl        String
  currentLocation  String?
  portfolioUrl     String?
  highestDegree    String?
  collegeName      String?
  graduationYear   String?
  cgpa             String?
  specialization   String?
  startDate        String?
  onSitePreference String?
  coverNote        String?
  source           String?
  status           String   @default("applied") // applied, screening, shortlisted, interview, selected, rejected, hired
  submittedAt      DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
}
